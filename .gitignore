# The SRD corpus is a transient build input. It is not committed; it is
# re-fetched from its upstream and enriched into a vault by the pipeline.
/fixtures/

# The spike scripts build with `go run .`, so no binaries are produced.
# These rules used to ignore the *binaries* named search, watcher and
# baselines - but gitignore matches directories too, so they silently
# excluded the whole spikes/measurement/search and
# spikes/measurement/watcher source packages from the repository.

# Build output.
/dist/

# Frontend build output and dependencies.
/web/node_modules/
/web/dist/
/internal/server/webdist/*
!/internal/server/webdist/.gitkeep

# Playwright e2e dependencies and artifacts.
# playwright.config.ts retains trace, screenshot and video on failure, so a
# red run leaves test-results/ behind; it is evidence, not source.
/e2e/node_modules/
/e2e/test-results/


# Vault runtime state (accounts, sessions, journal, secrets). App-private,
# regenerated on launch — never committed.
dev/demo-campaign/vault/.demitable/
